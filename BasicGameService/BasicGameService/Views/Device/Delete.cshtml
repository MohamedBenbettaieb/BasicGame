@model BasicGameService.Models.Device

@{
    ViewData["Title"] = "Delete Device";
}

<h1>Delete Device</h1>

<h4>Are you sure you want to delete this device?</h4>


@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<div class="mb-3">
    <strong>Device Name:</strong> @Model.Name <br />
    <strong>Device Type:</strong> @Model.Type <br />
    <strong>Status:</strong> @(Model.IsAvailable ? "Available" : "In Use")
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
